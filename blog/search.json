---
layout: null
permalink: /blog/search.json
sitemap: false
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | truncate: 200 | jsonify }},
    "category": {{ post.category | default: "" | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%b %-d, %Y" | jsonify }},
    "words": {{ post.content | strip_html | number_of_words }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
